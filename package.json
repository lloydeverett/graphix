{
  "name": "graphix",
  "private": true,
  "version": "0.0.0",
  "description": "Live in-browser HTML editor with Mermaid diagrams",
  "source": [
    "src/index.html",
    "src/preview.html"
  ],
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "parcel",

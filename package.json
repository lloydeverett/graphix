  },
  "dependencies": {
    "lit": "^3.3.3",
    "mermaid": "^12.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "buffer": "^6.0.3",
    "parcel": "^2.16.4",
    "process": "^0.11.10",
    "typescript": "^7.0.2"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}

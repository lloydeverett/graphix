{
  "name": "graphix",
  "private": true,
  "version": "0.0.0",
  "description": "Live in-browser HTML editor with Mermaid diagrams",
  "source": [
    "src/index.html",
    "src/preview.html"
  ],
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "parcel",
    "build": "parcel build",
    "build:same-origin": "GRAPHIX_SAME_ORIGIN_PREVIEW=1 parcel build --public-url ./",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@lezer/highlight": "^1.2.4",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "elkjs": "^0.9.3",
    "lit": "^3.3.3",
    "lucide": "^1.48.0",
    "mermaid": "^12.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.8",
    "buffer": "^6.0.3",
    "parcel": "^2.16.4",
    "process": "^0.11.10",
    "typescript": "^7.0.2"
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
